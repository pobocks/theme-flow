
<div id="container">

  <!--
    Gallery title
  -->
  <header>
    <h1><a href="{{relative gallery.home.url}}">{{gallery.title}}</a></h1>
  </header>

  <!--
    Breadcrumbs of parent albums
  -->
  <nav class="breadcrumbs">
    {{#each breadcrumbs~}}
      <a class="breadcrumb-item" href="{{relative url}}">{{title}}</a>&nbsp;/&nbsp;
    {{~/each~}}
    <a class="breadcrumb-item" href="{{relative album.url}}">{{album.title}}</a>
  </nav>

  {{#if settings.featuredAlbum}}
  {{#if album.home}}
    <!--
      Featured album slider (on homepage only)
    -->
    <ul id="lightSlider">
      {{! Find the featured album, if any !}}
      {{#each album.albums~}}
        {{#compare title '==' @root.settings.featuredAlbum}}
          {{! Display its image files in the slider !}}
          {{#each files~}}
            {{#unless isVideo}}
              <li data-thumb="{{relative_to_s3 urls.thumbnail}}" data-src="{{relative_to_s3 urls.large}}">
                <img src="{{relative_to_s3 urls.large}}" alt="{{filename}}">
              </li>
            {{/unless}}
          {{~/each}}
        {{/compare}}
      {{~/each}}
    </ul>
  {{/if}}
  {{/if}}
  <!-- project statement and jumplist -->
  {{#if album.home}}
  {{#if settings.project_description}}
  <div class="preamble">
  <details id="project-description" open>
  <summary>Project Description</summary>
  {{{settings.project_description}}}
  </details>
  </div>
  {{/if}}
  <div class="jumplist-container">
  <select id="jumplist" onfocus="this.selectedIndex = 0" onchange="location = this.options[this.selectedIndex].value;">
    <option value="" style="display: none">Jump to dog by name!</option>
    {{#each album.albums~}}
      {{#compare title '!=' 'All Pics'}}
      {{#compare title '!=' 'Top Shots'}}
      {{#compare title '!=' 'Unknown'}}
        <option value="#{{remove_extension url}}">{{title}}</option>
      {{/compare}}{{/compare}}{{/compare}}
    {{~/each}}
  </select>
  </div>
  {{/if}}
   <nav role="tablist">
    <!--
        The aria-selected="true" and tabindex="0" attributes are omitted for this example
        See: https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Roles/tab_role#example
      -->
    <label role="tab" aria-controls="albums" for="tab-1" class="tab-label">
      <input type="radio" name="tab-group-1" id="tab-1" checked />
      Dogs
    </label>
    <label role="tab" aria-controls="misc-bullshit" for="tab-2" class="tab-label">
      <input type="radio" name="tab-group-1" id="tab-2" />
      Tab 2
    </label>
  </nav>
  <!--
    Nested albums, if any
  -->
  <div id="albums" class="justified-gallery" role="tabpanel" aria-labeled-by="tab-1">
    {{#each album.albums~}}
      {{#if (included_in title 'All Pics;Top Shots;Unknown')}}
      <a href="{{relative url}}" id="{{remove_extension url}}">
        <img src="{{relative_to_s3 previews.0.urls.small}}" alt="">
        <div class="caption" style="display: inline-block">
          <h3>{{title}}</h3>
          <div class="summary">{{summary}}</div>
        </div>
      </a>
      {{/if}}
    {{/each~}}
    {{#each album.albums~}}
      {{! Hide the featured album from listings !}}
      {{#unless (included_in title 'All Pics;Top Shots;Unknown')}}
      {{#compare title '!=' @root.settings.featuredAlbum}}
        <a href="{{relative url}}" id="{{remove_extension url}}">
          <img src="{{relative_to_s3 previews.0.urls.small}}" alt="">
          <div class="caption" style="display: inline-block">
            <h3>{{title}}</h3>
            <div class="summary">{{summary}}</div>
          </div>
        </a>
      {{/compare}}{{/unless}}
    {{~/each}}
  </div>
  <div id="misc-bullshit" class="justified-gallery" role="tabpanel" aria-labeled-by="tab-2">
  <p>Some bullshit goes here</p>
  </div>
  <!--
    All photos and videos
  -->
  <ul id="media" class="clearfix justified-gallery">
    {{#each album.files~}}
      {{> thumbnail}}
    {{~/each}}
  </ul>

  <!--
    Pagination
  -->
  {{#compare pagination.length '>' 1}}
    <nav class="pagination">
      Pages:
      {{#each pagination}}
        {{#if current}}
          <a class="page current" href="{{relative url}}">{{index}}</a>
        {{else}}
          <a class="page" href="{{relative url}}">{{index}}</a>
        {{/if}}
      {{/each}}
    </nav>
  {{/compare}}

  <!--
    Zip file link
  -->
  {{#if album.zip}}
    <div id="zip">
      Download album as a <a href="{{album.zip}}">zip file</a>.
    </div>
  {{/if}}

  <!--
    Optional footer
  -->
  {{#if gallery.footer}}
  <footer>
    <p>{{{gallery.footer}}}</p>
  </footer>
  {{/if}}

</div>
